<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPS speed readout. There is no CAN bus on a Grand i10 Magna, so speed comes from GPS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Required from API 30 to see other installed apps at all (tiles + drawer). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Normal permission on SDK 30, no runtime prompt. Used for the connection status line. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/DashTheme"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Never reads a notification. It is the only key Android accepts for
          MediaSessionManager.getActiveSessions().
        -->
        <service
            android:name=".DashNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:theme="@style/DashTheme.Opaque" />

        <activity
            android:name=".IconPackPickerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:theme="@style/DashTheme.Opaque" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:theme="@style/DashTheme.Opaque" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:theme="@style/DashTheme.Opaque" />

        <activity
            android:name=".DrawerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:theme="@style/DashTheme.Opaque" />

    </application>
</manifest>
