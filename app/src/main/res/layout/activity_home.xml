<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple-influenced home screen. 1280x720 at density 160, so 1dp == 1px on this unit.
  Hero 466dp + dock 254dp = 720dp exactly.

  Apple language applied honestly:
    - true black ground, not lifted charcoal
    - translucent MATERIAL fills instead of borders (flat, no live blur: RenderEffect
      behind an always-visible dock would be the most expensive thing on an RK3326)
    - tight negative tracking, light clock weight, tabular figures
    - pill chips for status
    - the app icon IS the tile, no container behind it
  Not used, deliberately: SF Pro and SF Symbols are licensed for Apple platforms only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wash">

    <!-- Your photo, when one is present. Falls through to the colour wash above. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="466dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_hero" />

    <LinearLayout
        android:id="@+id/normal_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ================= HERO ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="466dp"
            android:orientation="horizontal"
            android:paddingStart="54dp"
            android:paddingEnd="54dp"
            android:paddingTop="46dp"
            android:paddingBottom="42dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9:59"
                    android:textColor="@color/ink"
                    android:textSize="132dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.045"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Monday, 14 September"
                    android:textColor="@color/ink_soft"
                    android:textSize="21dp"
                    android:letterSpacing="-0.01" />

                <!-- status pills -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bt_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Bluetooth off"
                        android:textColor="@color/ink_soft"
                        android:textSize="14.5dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/gps_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/chip_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Waiting for GPS"
                        android:textColor="@color/ink_soft"
                        android:textSize="14.5dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/accent"
                        android:textSize="142dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.05"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/speed_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/kmh"
                        android:textColor="@color/ink_soft"
                        android:textSize="20dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!--
                  Trip stats. Replaces the media card when nothing is playing rather than
                  adding a fourth thing to the screen.
                -->
                <LinearLayout
                    android:id="@+id/trip_card"
                    android:layout_width="452dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:background="@drawable/material_card"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/trip_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/this_trip"
                        android:textColor="@color/muted"
                        android:textSize="13dp"
                        android:letterSpacing="0.09"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/trip_distance"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/ink" android:textSize="34dp"
                                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                            <TextView android:id="@+id/trip_distance_unit"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/km"
                                android:textColor="@color/muted" android:textSize="13dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/trip_avg"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/ink" android:textSize="34dp"
                                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                            <TextView android:id="@+id/trip_avg_unit"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/avg_kmh"
                                android:textColor="@color/muted" android:textSize="13dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/trip_max"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/ink" android:textSize="34dp"
                                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                            <TextView android:id="@+id/trip_max_unit"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/max_kmh"
                                android:textColor="@color/muted" android:textSize="13dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:id="@+id/trip_time"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/ink" android:textSize="34dp"
                                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="@string/moving"
                                android:textColor="@color/muted" android:textSize="13dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- media, as material -->
                <LinearLayout
                    android:id="@+id/now_playing"
                    android:layout_width="452dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/material_card"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/np_art"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/art_gradient"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="15dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/np_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nothing_playing"
                            android:textColor="@color/ink"
                            android:textSize="17dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.01"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/np_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nothing_playing_sub"
                            android:textColor="@color/muted"
                            android:textSize="14dp"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- transport. Hidden until a real media session exists. -->
                    <ImageView
                        android:id="@+id/np_play"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_play"
                        android:background="@drawable/ctrl_bg"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/np_next"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="14dp"
                        android:src="@drawable/ic_next"
                        android:background="@drawable/ctrl_bg"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!--
                  Compact trip line, for when the media card is already using the full card
                  slot. A second full card would not fit in the 137dp of spare height, and
                  two cards competing for one corner stops the screen being glanceable.
                -->
                <TextView
                    android:id="@+id/trip_strip"
                    android:layout_width="452dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:gravity="end"
                    android:textColor="@color/muted"
                    android:textSize="15dp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= DOCK ================= -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@color/dock_bg"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="22dp"
            android:paddingBottom="26dp"
            android:baselineAligned="false" />
    </LinearLayout>

    <!-- Inflated on first use. A car that never moves never pays for it. -->
    <ViewStub
        android:id="@+id/drive_stub"
        android:layout="@layout/home_drive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/drive_root" />

    <!--
      Night dimming. A plain black view at low alpha over everything, which costs one
      composited layer. Dimming via alpha on each element would mean touching every view
      and would still not dim the wallpaper.
    -->
    <View
        android:id="@+id/night_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Trip options. Long press the trip card. No permanent chrome on the home screen. -->
    <LinearLayout
        android:id="@+id/trip_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="452dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/menu_bg">

            <TextView
                android:id="@+id/trip_menu_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/start_new_trip"
                android:textColor="@color/ink"
                android:textSize="18dp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/row_bg"
                android:clickable="true"
                android:focusable="true" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/trip_menu_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/ink_soft"
                android:textSize="18dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/trip_menu_hide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/hide_trip_card"
                android:textColor="@color/accent"
                android:textSize="18dp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/row_bg"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Screen off. Not a real display sleep: on these units sleep sometimes does not come
      back cleanly, and a black view is instant and safe. Tap anywhere to wake.
    -->
    <LinearLayout
        android:id="@+id/screen_off"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/screen_off_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#40FFFFFF"
            android:textSize="64dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/screen_off_hint"
            android:textColor="#26FFFFFF"
            android:textSize="16dp" />
    </LinearLayout>
</FrameLayout>
