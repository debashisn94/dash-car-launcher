<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple-influenced home screen. 1280x720 at density 160, so 1dp == 1px on this unit.
  Hero 466dp + dock 254dp = 720dp exactly.

  Apple language applied honestly:
    - true black ground, not lifted charcoal
    - translucent MATERIAL fills instead of borders (flat, no live blur: RenderEffect
      behind an always-visible dock would be the most expensive thing on an RK3326)
    - tight negative tracking, light clock weight, tabular figures
    - pill chips for status
    - the app icon IS the tile, no container behind it
  Not used, deliberately: SF Pro and SF Symbols are licensed for Apple platforms only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wash">

    <!-- Your photo, when one is present. Falls through to the colour wash above. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="466dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_hero" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ================= HERO ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="466dp"
            android:orientation="horizontal"
            android:paddingStart="54dp"
            android:paddingEnd="54dp"
            android:paddingTop="46dp"
            android:paddingBottom="42dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9:59"
                    android:textColor="@color/ink"
                    android:textSize="132dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.045"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Monday, 14 September"
                    android:textColor="@color/ink_soft"
                    android:textSize="21dp"
                    android:letterSpacing="-0.01" />

                <!-- status pills -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bt_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Bluetooth off"
                        android:textColor="@color/ink_soft"
                        android:textSize="14.5dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/gps_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/chip_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Waiting for GPS"
                        android:textColor="@color/ink_soft"
                        android:textSize="14.5dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/accent"
                        android:textSize="142dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.05"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/kmh"
                        android:textColor="@color/ink_soft"
                        android:textSize="20dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- media, as material -->
                <LinearLayout
                    android:id="@+id/now_playing"
                    android:layout_width="452dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/material_card"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/np_art"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/art_gradient"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="15dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/np_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nothing_playing"
                            android:textColor="@color/ink"
                            android:textSize="17dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.01"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/np_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/nothing_playing_sub"
                            android:textColor="@color/muted"
                            android:textSize="14dp"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- transport. Hidden until a real media session exists. -->
                    <ImageView
                        android:id="@+id/np_play"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_play"
                        android:background="@drawable/ctrl_bg"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/np_next"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="14dp"
                        android:src="@drawable/ic_next"
                        android:background="@drawable/ctrl_bg"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= DOCK ================= -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@color/dock_bg"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="22dp"
            android:paddingBottom="26dp"
            android:baselineAligned="false" />
    </LinearLayout>
</FrameLayout>
