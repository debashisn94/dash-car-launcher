<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple-influenced dock slot. No container behind the icon: on iOS the icon IS the tile,
  and these head unit icons are already squircles. A container would be a squircle inside
  a squircle, which is the classic tell that someone copied the look without the logic.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/tile_bg"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ink_soft"
        android:textSize="15dp"
        android:letterSpacing="-0.01"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true" />
</LinearLayout>
